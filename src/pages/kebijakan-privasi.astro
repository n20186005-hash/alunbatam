---
import LegalPage from '../components/LegalPage.astro';
import { getContent } from '../content';
import { SITE_URL } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema, webPageSchema } from '../lib/schema';

export const prerender = true;

const t = getContent('id');
const doc = t.legal.privacy;
const title = `${doc.title} | ${t.meta.siteName}`;
const description = 'Kebijakan privasi Panduan Alun-Alun Batam Centre, termasuk data minimum, analitik, peta, penyimpanan preferensi, dan hak pengguna.';
const pageUrl = `${SITE_URL}/kebijakan-privasi/`;
const jsonLd = [
  webPageSchema({ name: doc.title, url: pageUrl, description }),
  breadcrumbSchema(
    [
      { name: t.hero.breadcrumbHome, url: `${SITE_URL}/` },
      { name: doc.title },
    ],
    `${pageUrl}#breadcrumb`,
  ),
];
---

<BaseLayout title={title} description={description} locale="id" jsonLd={jsonLd} noIndex>
  <LegalPage doc={doc} lang="id" title={title} description={description} homeLabel={t.hero.breadcrumbHome} homeHref="/" />
</BaseLayout>
