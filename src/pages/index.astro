---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

const title = 'Alun Alun Batam Centre Batam — Panduan Wisata';
const description = 'Panduan lengkap Alun Alun Batam Centre (Batam Centre Park / Dataran Engku Putri): sejarah, cara ke sana dari Ferry Terminal Batam Centre, fasilitas, jam akses, peta lokasi, dan FAQ. Ruang publik gratis & terbuka.';
const imagePath = '/images/hero-alun-alun-batam.webp';
const siteUrl = Astro.site;
const pageUrl = siteUrl ? new URL('/', siteUrl).toString() : undefined;
const imageUrl = siteUrl ? new URL(imagePath, siteUrl).toString() : undefined;

const openingDays = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'Alun Alun Batam Centre',
  alternateName: ['Dataran Engku Putri', 'Batam Centre Park'],
  description,
  ...(pageUrl ? { url: pageUrl } : {}),
  ...(imageUrl ? { image: [imageUrl] } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: '43H3+CRQ, Jl. Engku Putri',
    addressLocality: 'Teluk Tering, Batam Kota',
    addressRegion: 'Kepulauan Riau',
    postalCode: '29444',
    addressCountry: 'ID',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 1.1285985988558445,
    longitude: 104.05203871243594,
  },
  openingHoursSpecification: openingDays.map((dayOfWeek) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek,
    opens: '00:00',
    closes: '23:59',
  })),
  isAccessibleForFree: true,
  publicAccess: true,
};

const faqs = [
  {
    q: 'Apakah masuk ke Alun-Alun Batam Centre berbayar?',
    a: 'Tidak ditemukan tiket masuk reguler untuk ruang publik ini pada sumber pemerintah dan portal pariwisata nasional yang kami periksa. Acara khusus, parkir, atau layanan pihak ketiga di sekitar kawasan dapat memiliki biaya tersendiri.',
  },
  {
    q: 'Apakah Dataran Engku Putri buka 24 jam?',
    a: 'Layanan peta publik menampilkan akses sepanjang hari. Namun, fasilitas tertentu, penutupan sementara, pengaturan acara, atau pembatasan keamanan dapat memiliki jadwal berbeda. Periksa kondisi terkini sebelum kunjungan malam atau saat ada acara besar.',
  },
  {
    q: 'Kapan waktu yang paling nyaman untuk berkunjung?',
    a: 'Pagi sebelum cuaca terasa terik dan menjelang senja biasanya paling nyaman untuk berjalan, berolahraga, atau menikmati suasana ruang terbuka. Saat acara kota berlangsung, suasana lebih ramai dan pola akses dapat berubah.',
  },
  {
    q: 'Berapa lama waktu kunjungan yang disarankan?',
    a: 'Untuk mengenal Alun Alun Batam Centre (Batam Centre Park), berfoto, dan berjalan santai, siapkan sekitar satu hingga dua jam. Tambahkan waktu bila ingin menggabungkan kunjungan dengan museum, landmark, atau kegiatan publik di sekitar Batam Centre.',
  },
  {
    q: 'Bagaimana cara menuju alun-alun dari Bandara Hang Nadim?',
    a: 'Pilihan paling sederhana adalah taksi resmi atau angkutan berbasis aplikasi. Pemerintah Kota Batam juga sedang mengintegrasikan Koridor Nongsa–Batam Centre Trans Batam dengan Bandara Hang Nadim. Bila Anda tiba lewat Batam Centre Ferry Terminal, jarak menuju Alun Alun Batam Centre (Batam Centre Park) relatif dekat; periksa rute dan halte terkini sebelum mengandalkan satu moda.',
  },
  {
    q: 'Apakah ada tempat parkir?',
    a: 'Kawasan pusat pemerintahan Batam Centre memiliki pengaturan parkir yang dapat berubah sesuai kegiatan. Saat acara besar, ikuti rambu, petugas, dan zona parkir yang ditetapkan. Jangan memarkir kendaraan pada bahu jalan atau akses darurat.',
  },
  {
    q: 'Apakah tersedia toilet dan fasilitas dasar?',
    a: 'Ketersediaan serta jam akses toilet atau fasilitas sanitasi publik dapat berubah. Sebaiknya identifikasi fasilitas publik terdekat saat tiba dan jangan menjadikan toilet taman sebagai satu-satunya rencana, terutama pada kunjungan malam atau acara besar.',
  },
  {
    q: 'Apakah alun-alun cocok untuk keluarga?',
    a: 'Portal pariwisata nasional menyebut kawasan ini sebagai ruang publik keluarga dengan area bermain dan ruang untuk bersantai. Tetap awasi anak, perhatikan kendaraan di jalan sekeliling kawasan, dan siapkan perlindungan dari panas atau hujan.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<BaseLayout title={title} description={description} image={imagePath} jsonLd={[attractionSchema, faqSchema]}>
  <section class="relative overflow-hidden bg-[#082f34] text-white">
    <div class="absolute inset-0">
      <img src={imagePath} alt="Alun Alun Batam Centre (Batam Centre Park) dengan ruang terbuka dan lingkungan pusat kota" class="h-full w-full object-cover opacity-55" fetchpriority="high" />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,31,34,.93)_0%,rgba(5,31,34,.68)_48%,rgba(5,31,34,.2)_100%)]"></div>
      <div class="absolute inset-x-0 bottom-0 h-52 bg-gradient-to-t from-[#082f34] to-transparent"></div>
    </div>
    <div class="container-shell relative grid min-h-[78vh] items-end gap-12 py-16 lg:grid-cols-[1.25fr_.75fr] lg:py-24">
      <div class="max-w-4xl">
        <p class="mb-5 inline-flex items-center gap-3 text-xs font-extrabold uppercase tracking-[.2em] text-[#f0cf82]"><span class="h-px w-10 bg-[#d4a84f]"></span> Ruang publik · Batam Kota</p>
        <h1 class="font-[Georgia] text-[clamp(3.2rem,8vw,7.7rem)] font-normal leading-[.88] tracking-[-.055em]">Alun Alun Batam Centre<br /><span class="text-[#f1d38e]">(Batam Centre Park)</span></h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/82">Dataran Engku Putri (Batam Centre Park) adalah ruang temu warga di jantung pusat pemerintahan Batam—tempat olahraga, acara kota, rekreasi keluarga, dan jejak sejarah Melayu bertemu dalam satu bentang perkotaan.</p>
        <p class="mt-3 text-xs leading-5 text-white/55">Foto utama: Kementerian Pariwisata Republik Indonesia / Indonesia.travel.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-primary !bg-[#d4a84f] !text-[#17363a] hover:!bg-[#e2bd6d]" href="#rencana-kunjungan">Rencanakan kunjungan</a>
          <a class="btn-ghost !border-white/25 !bg-white/8 !text-white hover:!bg-white/16" href="#sejarah">Baca latar sejarah</a>
        </div>
      </div>
      <aside class="card-dark !bg-[#0a4147]/82 p-6 backdrop-blur-xl lg:mb-2">
        <p class="rule-label !text-[#efcd7e]">Ringkas sebelum berangkat</p>
        <dl class="mt-5 divide-y divide-white/12 text-sm">
          <div class="flex justify-between gap-5 py-3"><dt class="text-white/62">Nama lain</dt><dd class="text-right font-semibold">Dataran Engku Putri · Batam Centre Park</dd></div>
          <div class="flex justify-between gap-5 py-3"><dt class="text-white/62">Karakter</dt><dd class="text-right font-semibold">Ruang publik kota</dd></div>
          <div class="flex justify-between gap-5 py-3"><dt class="text-white/62">Akses peta</dt><dd class="text-right font-semibold">Tercantum sepanjang hari*</dd></div>
          <div class="flex justify-between gap-5 py-3"><dt class="text-white/62">Tiket reguler</dt><dd class="text-right font-semibold">Tidak ditemukan</dd></div>
          <div class="flex justify-between gap-5 py-3"><dt class="text-white/62">Saran durasi</dt><dd class="text-right font-semibold">1–2 jam</dd></div>
          <div class="flex justify-between gap-5 py-3"><dt class="text-white/62">Koordinat</dt><dd class="text-right font-semibold">1.128599, 104.052039</dd></div>
        </dl>
        <p class="mt-4 text-xs leading-5 text-white/55">*Jam fasilitas, acara, dan pembatasan akses dapat berbeda dari akses ruang terbuka.</p>
      </aside>
    </div>
  </section>

  <section class="border-b border-black/8 bg-[#f1eadb]">
    <div class="container-shell grid gap-px overflow-hidden border-x border-black/8 bg-black/8 md:grid-cols-4">
      {[
        ['01', 'Ruang kota', 'Pusat pertemuan warga, olahraga, dan acara publik.'],
        ['02', 'Jejak Melayu', 'Nama Engku Putri mengingatkan pada tokoh Engku Hamidah.'],
        ['03', 'Mudah dipadukan', 'Berada di kawasan Batam Centre yang terhubung dengan moda kota dan dekat Batam Centre Ferry Terminal.'],
        ['04', 'Nonkomersial', 'Panduan ini tidak menerima komisi dan tidak merekomendasikan pedagang tertentu.'],
      ].map(([n, heading, copy]) => (
        <article class="bg-[#f7f3e8] p-6 md:p-7">
          <p class="font-[Georgia] text-4xl text-[#d4a84f]">{n}</p>
          <h2 class="mt-5 text-lg font-extrabold">{heading}</h2>
          <p class="mt-2 text-sm leading-6 text-[#607278]">{copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="tentang" class="section-pad">
    <div class="container-shell grid items-start gap-12 lg:grid-cols-[.8fr_1.2fr]">
      <div class="lg:sticky lg:top-28">
        <p class="eyebrow">Mengenal tempat</p>
        <h2 class="section-title mt-5">Bukan sekadar lapangan.</h2>
        <p class="prose-copy mt-6 max-w-md">Alun Alun Batam Centre (Batam Centre Park) bekerja sebagai halaman bersama kota: terbuka, mudah dibaca, dan terus berubah mengikuti ritme masyarakat Batam.</p>
      </div>
      <div class="space-y-7">
        <div class="card p-7 md:p-9">
          <p class="text-xl leading-9 text-[#2e454b]">Portal pariwisata nasional Indonesia menyebut Alun Alun Batam Centre (Batam Centre Park)—juga dikenal sebagai Dataran Engku Putri—sebagai <strong class="text-[#0a4147]">ruang publik utama Kota Batam</strong>. Letaknya berada di pusat pemerintahan, dengan fungsi untuk berkumpul, bersantai, berolahraga, kegiatan keluarga, serta acara budaya, hiburan, dan olahraga.</p>
        </div>
        <div class="grid gap-5 md:grid-cols-2">
          <article class="card p-7">
            <div class="icon-box" aria-hidden="true">◎</div>
            <h3 class="mt-5 text-xl font-extrabold">Fungsi sipil yang hidup</h3>
            <p class="mt-3 text-sm leading-7 text-[#607278]">Berita Pemerintah Kota Batam sepanjang 2026 menunjukkan Alun Alun Batam Centre (Batam Centre Park) / Dataran Engku Putri tetap dipakai untuk peluncuran layanan publik, kegiatan olahraga, dan pertemuan warga berskala besar.</p>
          </article>
          <article class="card p-7">
            <div class="icon-box" aria-hidden="true">◇</div>
            <h3 class="mt-5 text-xl font-extrabold">Ruang yang terus diperbarui</h3>
            <p class="mt-3 text-sm leading-7 text-[#607278]">Lapangan olahraga di kawasan ini direvitalisasi pada 2026. Artinya, kondisi fisik dapat berubah dari foto lama; utamakan kondisi di lapangan ketika berkunjung.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section id="sejarah" class="section-pad bg-[#0a4147] text-white">
    <div class="container-shell grid gap-10 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="eyebrow !text-[#e9c976]">Jejak nama</p>
        <h2 class="section-title mt-5 max-w-2xl">Engku Putri, nama dengan ingatan sejarah.</h2>
        <div class="mt-8 h-px w-24 bg-[#d4a84f]"></div>
      </div>
      <div class="space-y-6 text-base leading-8 text-white/78">
        <p>Publikasi Kecamatan Batam Kota menjelaskan bahwa sosok <strong class="text-white">Engku Putri bernama Engku Hamidah</strong>, putri Raja Haji dalam tradisi Kerajaan Melayu Riau–Lingga. Ia dikenang sebagai tokoh yang berwibawa, memahami urusan ekonomi dan politik, serta memegang peran adat kerajaan.</p>
        <p>Nama itu membuat alun-alun memiliki lapisan makna yang lebih dalam daripada sekadar ruang terbuka: ia menghubungkan pusat pemerintahan Batam masa kini dengan memori sejarah Melayu–Bugis di Kepulauan Riau.</p>
        <div class="rounded-2xl border border-white/15 bg-white/6 p-5 text-sm leading-7 text-white/66">
          <strong class="text-[#efcd7e]">Catatan sumber:</strong> bagian sejarah ini mengikuti publikasi resmi Kecamatan Batam Kota. Kami tidak menambahkan legenda atau detail biografis yang tidak dapat dilacak ke sumber publik yang jelas.
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell">
      <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
        <div>
          <p class="eyebrow">Galeri lapangan</p>
          <h2 class="section-title mt-5">Wajah ruang publik Batam.</h2>
        </div>
        <p class="max-w-md text-sm leading-6 text-[#607278]">Foto sengaja disimpan lokal agar halaman cepat dan tidak bergantung pada pemuat gambar pihak ketiga. Hak foto tetap pada pemilik masing-masing.</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-12">
        <figure class="malay-frame overflow-hidden rounded-[1.8rem] md:col-span-7 md:row-span-2">
          <img src="/images/engku-putri-panorama.jpg" alt="Panorama udara kawasan Dataran Engku Putri" class="h-full min-h-[420px] w-full object-cover" loading="lazy" />
          <figcaption class="absolute inset-x-4 bottom-4 rounded-xl bg-black/62 px-4 py-3 text-xs text-white/80 backdrop-blur">Panorama kawasan · sumber editorial: WowKeren</figcaption>
        </figure>
        <figure class="relative overflow-hidden rounded-[1.8rem] md:col-span-5">
          <img src="/images/engku-putri-senja.jpg" alt="Suasana Dataran Engku Putri menjelang senja" class="h-[260px] w-full object-cover" loading="lazy" />
          <figcaption class="absolute inset-x-4 bottom-4 rounded-xl bg-black/62 px-4 py-3 text-xs text-white/80 backdrop-blur">Suasana senja · arsip pariwisata lokal</figcaption>
        </figure>
        <figure class="relative overflow-hidden rounded-[1.8rem] md:col-span-5">
          <img src="/images/engku-putri-udara.jpg" alt="Dataran Engku Putri dilihat dari udara" class="h-[260px] w-full object-cover" loading="lazy" />
          <figcaption class="absolute inset-x-4 bottom-4 rounded-xl bg-black/62 px-4 py-3 text-xs text-white/80 backdrop-blur">Tampak udara · arsip editorial detikInet</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="rencana-kunjungan" class="section-pad bg-[#efe7d7]">
    <div class="container-shell">
      <p class="eyebrow">Rencana kunjungan</p>
      <div class="mt-5 grid gap-10 lg:grid-cols-[.75fr_1.25fr]">
        <div>
          <h2 class="section-title">Datang dengan ekspektasi yang tepat.</h2>
          <p class="prose-copy mt-6">Ini adalah ruang publik aktif, bukan objek wisata berpagar. Pengalaman terbaik datang dari membaca cuaca, kegiatan kota, dan fasilitas yang tersedia pada hari kunjungan.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {[
            ['◷', 'Waktu terbaik', 'Pagi sebelum terik atau menjelang senja. Malam lebih hidup, terutama saat ada kegiatan publik.'],
            ['⌛', 'Durasi', 'Saran 1–2 jam untuk berjalan santai, berfoto, dan memahami kawasan.'],
            ['Rp', 'Tiket / biaya', 'Tidak ditemukan tiket masuk reguler. Acara, parkir, atau layanan pihak ketiga dapat berbayar.'],
            ['P', 'Parkir', 'Ikuti rambu dan petugas. Saat acara besar, zona parkir dan akses kendaraan dapat diatur khusus.'],
          ].map(([icon, heading, copy]) => (
            <article class="card p-6">
              <div class="icon-box font-bold" aria-hidden="true">{icon}</div>
              <h3 class="mt-4 text-lg font-extrabold">{heading}</h3>
              <p class="mt-2 text-sm leading-6 text-[#607278]">{copy}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Fasilitas & kebutuhan praktis</p>
        <h2 class="section-title mt-5">Yang perlu dicari, bukan diasumsikan.</h2>
        <p class="prose-copy mt-6">Karena fasilitas ruang publik dapat berganti, daftar berikut memakai pendekatan konservatif: kami memberi tahu jenis layanan yang perlu dicari tanpa mengiklankan operator tertentu.</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {[
          ['🚻', 'Toilet umum', 'Periksa fasilitas sanitasi publik terdekat saat tiba; jam akses dapat berbeda.'],
          ['♿', 'Aksesibilitas', 'Permukaan alun-alun relatif terbuka, tetapi kondisi jalur landai, trotoar, dan penyeberangan perlu dicek di lapangan.'],
          ['☂', 'Panas & hujan', 'Bawa air minum, pelindung matahari, dan payung atau jas hujan ringan sesuai cuaca.'],
          ['🍽', 'Makan & minum', 'Cari kios UMKM saat acara, warung, rumah makan lokal, atau area makan umum di kawasan Batam Centre.'],
          ['⌂', 'Akomodasi', 'Pilih hotel, penginapan kota, atau apartemen sewa yang legal di area Batam Centre sesuai kebutuhan mobilitas.'],
          ['▣', 'Belanja kebutuhan', 'Minimarket, pasar swalayan, dan pusat kebutuhan harian tersedia di kawasan perkotaan sekitar.'],
          ['⛽', 'Bahan bakar', 'SPBU berada di jaringan jalan kota; cek rute sebelum berkendara karena arus lalu lintas sekitar pusat kota dapat berubah.'],
          ['⚡', 'Pengisian kendaraan listrik', 'Ketersediaan pengisian publik berkembang; periksa aplikasi atau peta jaringan resmi sebelum bergantung pada satu titik.'],
        ].map(([icon, heading, copy]) => (
          <article class="rounded-2xl border border-black/8 bg-white/55 p-5">
            <span class="text-xl font-black text-[#0f5f62]" aria-hidden="true">{icon}</span>
            <h3 class="mt-3 font-extrabold">{heading}</h3>
            <p class="mt-2 text-sm leading-6 text-[#607278]">{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="transportasi" class="section-pad bg-[#0a3035] text-white">
    <div class="container-shell">
      <p class="eyebrow !text-[#e9c976]">Transportasi rinci</p>
      <div class="mt-5 grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
        <div>
          <h2 class="section-title">Menuju pusat Batam tanpa tebakan.</h2>
          <p class="mt-6 max-w-lg text-base leading-8 text-white/68">Gunakan nama “Alun Alun Batam Centre (Batam Centre Park)” atau “Dataran Engku Putri” pada aplikasi peta. Titik berada di Jl. Engku Putri, Teluk Tering, Kecamatan Batam Kota—berdekatan dengan kawasan Batam Centre Ferry Terminal.</p>
        </div>
        <div class="space-y-4">
          <article class="rounded-2xl border border-white/12 bg-white/6 p-6">
            <div class="flex gap-4"><span class="text-2xl" aria-hidden="true">✈</span><div><h3 class="text-xl font-extrabold">Dari Bandara Internasional Hang Nadim</h3><p class="mt-2 text-sm leading-7 text-white/68">Taksi resmi atau angkutan berbasis aplikasi adalah pilihan langsung. Pemerintah Kota Batam pada Mei 2026 menyatakan Koridor Nongsa–Batam Centre sedang disiapkan untuk terintegrasi dengan bandara. Karena statusnya merupakan pengembangan layanan, periksa rute dan halte terbaru sebelum berangkat.</p></div></div>
          </article>
          <article class="rounded-2xl border border-white/12 bg-white/6 p-6">
            <div class="flex gap-4"><span class="text-2xl" aria-hidden="true">▰</span><div><h3 class="text-xl font-extrabold">Dengan Trans Batam</h3><p class="mt-2 text-sm leading-7 text-white/68">Profil transportasi kota mencatat sejumlah koridor berujung atau melintasi Batam Centre, termasuk dari Sekupang, Tanjung Uncang, Jodoh, Tanjung Piayu, dan Nongsa. Cocok untuk perjalanan yang tidak terburu-buru; cek jadwal, halte, dan pembayaran terkini pada kanal resmi sebelum naik.</p></div></div>
          </article>
          <article class="rounded-2xl border border-white/12 bg-white/6 p-6">
            <div class="flex gap-4"><span class="text-2xl" aria-hidden="true">●</span><div><h3 class="text-xl font-extrabold">Taksi & angkutan berbasis aplikasi</h3><p class="mt-2 text-sm leading-7 text-white/68">Tetapkan titik turun di sisi jalan yang aman, hindari berhenti di jalur lalu lintas, dan konfirmasi identitas kendaraan sebelum naik. Untuk taksi, gunakan antrean atau operator resmi dan pastikan skema tarif dipahami sebelum perjalanan.</p></div></div>
          </article>
          <article class="rounded-2xl border border-white/12 bg-white/6 p-6">
            <div class="flex gap-4"><span class="text-2xl" aria-hidden="true">≈</span><div><h3 class="text-xl font-extrabold">Dari Batam Centre Ferry Terminal</h3><p class="mt-2 text-sm leading-7 text-white/68">Batam Centre Ferry Terminal dan Alun Alun Batam Centre (Batam Centre Park) sama-sama berada di kawasan inti Batam Centre. Pilihan perjalanan dapat berupa perjalanan singkat dengan taksi/angkutan aplikasi atau berjalan bila kondisi cuaca, barang bawaan, trotoar, dan kemampuan fisik memungkinkan. Gunakan peta untuk memilih penyeberangan yang aman menuju Dataran Engku Putri.</p></div></div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell grid gap-10 lg:grid-cols-[.9fr_1.1fr]">
      <div>
        <p class="eyebrow">Peta lokasi</p>
        <h2 class="section-title mt-5">Titik rujukan di Teluk Tering.</h2>
        <p class="prose-copy mt-6">Peta berasal dari Google Maps dan dimuat hanya pada bagian ini. Bahasa serta wilayah peta tertanam disetel ke Indonesia.</p>
        <address class="mt-6 not-italic text-sm leading-7 text-[#43565c]"><strong class="text-[#10242a]">Alun Alun Batam Centre (Batam Centre Park) / Dataran Engku Putri</strong><br />43H3+CRQ, Jl. Engku Putri<br />Teluk Tering, Kec. Batam Kota<br />Kota Batam, Kepulauan Riau 29444</address>
        <a class="btn-primary mt-6" href="https://maps.app.goo.gl/t2RNgQw92cCG7Yh18" target="_blank" rel="noopener noreferrer">Buka di Google Maps <span aria-hidden="true">↗</span></a>
      </div>
      <div class="overflow-hidden rounded-[1.8rem] border border-black/10 bg-white shadow-[0_25px_70px_rgba(16,36,42,.12)]">
        <iframe title="Peta Alun-Alun Batam Centre" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6897.722464829787!2d104.05203871243594!3d1.1285985988558445!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31d9890456e5474d%3A0xee8d00d5385ae78e!2sAlun%20Alun%20Batam%20Centre!5e1!3m2!1sid!2sid!4v1787145062295!5m2!1sid!2sid" width="600" height="520" class="h-[520px] w-full" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
    </div>
  </section>

  <section class="section-pad bg-[#efe7d7]">
    <div class="container-shell">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class="eyebrow">Kuliner sekitar</p>
          <h2 class="section-title mt-5">Kenali jenisnya, pilih sendiri tempatnya.</h2>
          <p class="prose-copy mt-6">Sebagai panduan nirlaba, kami tidak mengarahkan pengunjung ke pedagang tertentu. Di Batam Centre, cari kategori yang sesuai kebutuhan dan cek kebersihan, harga, serta jam buka sendiri.</p>
          <div class="mt-7 flex flex-wrap gap-2">
            {['Warung lokal', 'Kios UMKM saat acara', 'Rumah makan keluarga', 'Pusat jajanan', 'Hidangan laut', 'Makanan Melayu Kepulauan'].map((item) => <span class="pill">{item}</span>)}
          </div>
          <p class="mt-5 text-sm leading-7 text-[#607278]">Jenis hidangan khas Kepulauan Riau yang dapat dicari antara lain mie tarempa, olahan gonggong, hidangan laut, dan ragam masakan Melayu. Ketersediaan tergantung tempat dan hari.</p>
        </div>
        <div>
          <p class="eyebrow">Sekitar alun-alun</p>
          <h2 class="section-title mt-5">Tiga konteks publik untuk memperpanjang kunjungan.</h2>
          <div class="mt-7 space-y-3">
            {[
              ['Museum Batam Raja Ali Haji', 'Museum publik untuk menambah konteks sejarah kota dan Kepulauan Riau.'],
              ['Landmark Welcome to Batam', 'Tanda kota yang menjadi titik orientasi visual di kawasan Batam Centre.'],
              ['Masjid Agung Batam', 'Landmark keagamaan dan arsitektur kota; hormati tata tertib serta waktu ibadah.'],
            ].map(([name, copy], i) => (
              <article class="flex gap-5 rounded-2xl border border-black/8 bg-white/55 p-5">
                <span class="kicker-num !text-4xl">0{i + 1}</span>
                <div><h3 class="font-extrabold">{name}</h3><p class="mt-1 text-sm leading-6 text-[#607278]">{copy}</p></div>
              </article>
            ))}
          </div>
          <p class="mt-4 text-xs leading-5 text-[#78868a]">Jarak, jam buka, dan akses dapat berubah. Periksa kanal resmi atau peta sebelum menggabungkan beberapa tempat dalam satu kunjungan.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Etika ruang bersama</p>
        <h2 class="section-title mt-5">Datang sebagai tamu, gunakan sebagai warga.</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <article class="card p-7"><span class="kicker-num">01</span><h3 class="mt-5 text-lg font-extrabold">Jaga fungsi publik</h3><p class="mt-2 text-sm leading-7 text-[#607278]">Jangan menutup jalur pejalan kaki, lapangan olahraga, akses darurat, atau area yang sedang dipakai kegiatan masyarakat.</p></article>
        <article class="card p-7"><span class="kicker-num">02</span><h3 class="mt-5 text-lg font-extrabold">Bawa pulang sampah</h3><p class="mt-2 text-sm leading-7 text-[#607278]">Gunakan tempat sampah yang tersedia. Bila penuh, simpan sampah hingga menemukan fasilitas pembuangan yang layak.</p></article>
        <article class="card p-7"><span class="kicker-num">03</span><h3 class="mt-5 text-lg font-extrabold">Hormati acara & ibadah</h3><p class="mt-2 text-sm leading-7 text-[#607278]">Patuhi pengaturan petugas dan jaga volume suara, terutama bila kawasan sekitar sedang digunakan untuk kegiatan resmi atau keagamaan.</p></article>
      </div>
    </div>
  </section>

  <section id="faq" class="section-pad bg-[#0c3d42] text-white">
    <div class="container-shell grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
      <div>
        <p class="eyebrow !text-[#e9c976]">Pertanyaan umum</p>
        <h2 class="section-title mt-5">Pertanyaan sebelum berangkat.</h2>
        <p class="mt-6 max-w-md text-sm leading-7 text-white/65">Jawaban disusun konservatif. Jika sumber publik tidak memastikan suatu fasilitas, kami menyatakannya sebagai hal yang perlu diperiksa, bukan membuat asumsi.</p>
      </div>
      <div class="divide-y divide-white/12 border-y border-white/12">
        {faqs.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-extrabold"><span>{item.q}</span><span class="text-2xl font-light text-[#e9c976] transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
            <p class="max-w-3xl pt-3 text-sm leading-7 text-white/68">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

