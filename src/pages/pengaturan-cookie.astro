---
import CookieForm from '../components/CookieForm.astro';
import LegalPage from '../components/LegalPage.astro';
import { getContent } from '../content';
import { SITE_URL } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema, webPageSchema } from '../lib/schema';

export const prerender = true;

const t = getContent('id');
const doc = t.legal.cookies;
const title = `${doc.title} | ${t.meta.siteName}`;
const description = 'Atur kuki dan preferensi privasi untuk Panduan Alun-Alun Batam Centre, termasuk analitik dan penyimpanan preferensi.';
const pageUrl = `${SITE_URL}/pengaturan-cookie/`;
const jsonLd = [
  webPageSchema({ name: doc.title, url: pageUrl, description }),
  breadcrumbSchema(
    [
      { name: t.hero.breadcrumbHome, url: `${SITE_URL}/` },
      { name: doc.title },
    ],
    `${pageUrl}#breadcrumb`,
  ),
];
---

<BaseLayout title={title} description={description} locale="id" jsonLd={jsonLd} noIndex>
  <LegalPage doc={doc} lang="id" title={title} description={description} homeLabel={t.hero.breadcrumbHome} homeHref="/">
    <CookieForm lang="id" />
  </LegalPage>
</BaseLayout>
