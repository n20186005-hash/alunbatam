---
import data from '../data/guide.json';import Layout from './Layout.astro';import type {Locale} from '../data/routes';
interface Props {locale:Locale;}
const {locale}=Astro.props,d=data.copy[locale],en=locale==='en',sources=data.sources;
const schema={'@context':'https://schema.org','@type':'TouristAttraction','@id':'https://alunbatam.com/#square',name:'Alun-Alun Batam Centre',alternateName:'Dataran Engku Putri',url:'https://alunbatam.com'+(en?'/en/':'/'),description:d.description,geo:{'@type':'GeoCoordinates',latitude:1.1285986,longitude:104.054619},address:{'@type':'PostalAddress',streetAddress:'43H3+CRQ, Jl. Engku Putri',addressLocality:'Tlk. Tering, Batam Kota, Kota Batam',addressRegion:'Kepulauan Riau',postalCode:'29444',addressCountry:'ID'}};
const faq={'@context':'https://schema.org','@type':'FAQPage',mainEntity:d.faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<Layout locale={locale} title={d.title} description={d.description}><main id="main"><section class="hero"><div><p class="eyebrow">Batam Centre · Kepulauan Riau</p><h1>{d.h1}</h1><p>{d.intro}</p><a class="button" href="#visit">{d.nav[1]}</a> <a class="button secondary" href={sources.maps}>Google Maps ↗</a></div><figure><img src="/images/civic-illustration.svg" alt={d.photoAlt} width="1600" height="900" fetchpriority="high"/><figcaption>{d.photoCaption}</figcaption></figure></section><p class="callout">{d.notice}</p><p class="eyebrow">{d.updated}</p>{d.sections.map(([id,h,p,key])=><section id={id}><h2>{h}</h2><p>{p}</p><a href={sources[key as keyof typeof sources]}>{en?'Source':'Sumber'} ↗</a></section>)}<section id="faq"><h2>{en?'Questions before visiting':'Pertanyaan sebelum berkunjung'}</h2>{d.faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><section id="sources"><h2>{en?'Public sources & limits':'Sumber publik & batas informasi'}</h2><p>{en?'An asset report, historical account or completed event is used for its stated scope. It does not establish today’s services or access.':'Laporan aset, uraian sejarah atau acara yang telah selesai digunakan sesuai lingkupnya. Itu bukan jaminan layanan atau akses hari ini.'}</p><ul><li><a href={sources.identity}>Media Center Batam — {en?'land-certificate report (11 June 2020)':'laporan sertipikat tanah (11 Juni 2020)'}</a></li><li><a href={sources.history}>Kecamatan Batam Kota — Manifestasi Ketokohan Engku Hamidah (26 Juni 2020)</a></li><li><a href={sources.event}>Disbudpar Batam — Batam 10K (20 September 2026)</a></li><li><a href={sources.maps}>Google Maps — Alun Alun Batam Centre</a></li></ul><p>{d.rating}</p><p>{d.updated}.</p></section></main><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/><script is:inline type="application/ld+json" set:html={JSON.stringify(faq)}/></Layout>
