---
import { getContent } from '../content';
import type { Locale } from '../i18n';

interface Props {
  lang?: Locale;
}
const { lang = 'id' } = Astro.props;
const t = getContent(lang);
---

<section id="rute" class="section-pad">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="eyebrow">{t.itineraries.eyebrow}</p>
      <h2 class="section-title mt-5">{t.itineraries.h2}</h2>
      <p class="prose-copy mt-6">{t.itineraries.lede}</p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        t.itineraries.audiences.map((route) => (
          <article class="card p-7">
            <span class="kicker-num">{route.kicker}</span>
            <h3 class="mt-5 text-xl font-extrabold">{route.title}</h3>
            <p class="mt-1 text-sm font-semibold text-[#0f5f62]">{route.audience}</p>
            <p class="mt-4 text-sm leading-7 text-[#607278]"><strong class="text-[#10242a]">{route.paceLabel}:</strong> {route.pace}</p>
            <p class="mt-3 text-sm leading-7 text-[#607278]"><strong class="text-[#10242a]">{route.stopsLabel}:</strong> {route.stops.join(' → ')}</p>
            <p class="mt-5 rounded-xl bg-[#f1eadb] p-4 text-sm leading-7 text-[#43565c]">{route.caution}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      <article class="rounded-[1.8rem] border border-black/8 bg-white/62 p-7 md:p-9">
        <p class="rule-label">{t.itineraries.halfDay.label}</p>
        <h3 class="mt-3 font-[Georgia] text-3xl">{t.itineraries.halfDay.title}</h3>
        <p class="mt-3 text-sm leading-7 text-[#607278]">{t.itineraries.halfDay.lede}</p>
        <ol class="mt-5 space-y-2 text-sm leading-7 text-[#43565c]">
          {t.itineraries.halfDay.steps.map((step) => <li>· {step}</li>)}
        </ol>
      </article>
      <article class="rounded-[1.8rem] border border-black/8 bg-white/62 p-7 md:p-9">
        <p class="rule-label">{t.itineraries.fullDay.label}</p>
        <h3 class="mt-3 font-[Georgia] text-3xl">{t.itineraries.fullDay.title}</h3>
        <p class="mt-3 text-sm leading-7 text-[#607278]">{t.itineraries.fullDay.lede}</p>
        <ol class="mt-5 space-y-2 text-sm leading-7 text-[#43565c]">
          {t.itineraries.fullDay.steps.map((step) => <li>· {step}</li>)}
        </ol>
      </article>
    </div>
  </div>
</section>
