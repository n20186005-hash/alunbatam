---
import data from '../data/guide.json';import {paths,type Locale,type PageKey} from '../data/routes';
interface Props {locale:Locale;page?:PageKey;title:string;description:string;noIndex?:boolean;errorPage?:boolean;}
const {locale,page='home',title,description,noIndex=false,errorPage=false}=Astro.props;const d=data.copy[locale],en=locale==='en',home=paths.home[locale],route=paths[page][locale],other=en?'id':'en',pair=paths[page][other];const canonical=new URL(route,Astro.site).href;const ids=['location','visit','history','travel','faq','sources'];
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#0a4147"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={noIndex||errorPage?'noindex,follow':'index,follow,max-image-preview:large'}/>{!errorPage&&<><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="id" href={new URL(paths[page].id,Astro.site).href}/><link rel="alternate" hreflang="en" href={new URL(paths[page].en,Astro.site).href}/><link rel="alternate" hreflang="x-default" href={new URL(paths[page].id,Astro.site).href}/></>}<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/>{!errorPage&&<meta property="og:url" content={canonical}/>}<meta property="og:image" content={new URL('/images/civic-social.png',Astro.site).href}/><meta property="og:image:alt" content={d.photoAlt}/><meta property="og:image:type" content="image/png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:image" content={new URL('/images/civic-social.png',Astro.site).href}/><meta name="twitter:image:alt" content={d.photoAlt}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><link rel="icon" href="/icons/favicon.svg"/><link rel="manifest" href="/site.webmanifest"/><link rel="stylesheet" href="/guide.css"/></head><body><a class="skip" href="#main">{en?'Skip to content':'Lewati ke konten'}</a><header><div class="brand"><a href={home}>Alun-Alun Batam Centre <small>{en?'Independent guide · Engku Putri':'Panduan independen · Engku Putri'}</small></a><a class="language" lang={other} href={pair}>{en?'Bahasa Indonesia':'English'}</a></div><nav aria-label={en?'Main navigation':'Navigasi utama'}>{ids.map((id,i)=><a href={home+'#'+id}>{d.nav[i]}</a>)}<a href={data.sources.maps}>Google Maps ↗</a></nav></header><slot/><aside id="cookie-banner" class="cookie-banner hidden" aria-label={en?'Cookie choices':'Pilihan kuki'}><p>{d.banner} <a href={paths.cookies[locale]}>{d.manage}</a></p><button type="button" data-cookie-reject>{d.reject}</button> <button type="button" data-cookie-accept>{d.allow}</button><p data-consent-status role="status" aria-live="polite"></p></aside><footer><p>{d.footer}</p><div class="footerlinks">{(['privacy','terms','cookies'] as const).map(key=><a href={paths[key][locale]}>{d.legal[key][0]}</a>)}</div><p>© 2026 Alun-Alun Batam Centre Guide</p></footer><script is:inline src="/js/consent.js" defer></script><script is:inline src="/js/retire-offline.js" defer></script></body></html>
