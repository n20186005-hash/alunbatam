---
import { getContent } from '../content';
import type { Locale } from '../i18n';

interface Props {
  lang?: Locale;
}
const { lang = 'id' } = Astro.props;
const t = getContent(lang);
---

<section id="fasilitas" class="section-pad">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="eyebrow">{t.services.eyebrow}</p>
      <h2 class="section-title mt-5">{t.services.h2}</h2>
      <p class="prose-copy mt-6">{t.services.lede}</p>
    </div>

    <div class="mt-10 space-y-8">
      {
        t.services.groups.map((group) => (
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-black/8 pb-3">
              <h3 class="text-xl font-extrabold">{group.title}</h3>
              <p class="text-sm text-[#78868a]">{group.note}</p>
            </div>
            <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
              {group.items.map((item) => (
                <article class="rounded-2xl border border-black/8 bg-white/55 p-5">
                  <span class="text-xl font-black text-[#0f5f62]" aria-hidden="true">{item.icon}</span>
                  <h4 class="mt-3 font-extrabold">{item.title}</h4>
                  <p class="mt-2 text-sm leading-6 text-[#607278]">{item.body}</p>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-9 rounded-2xl bg-[#f1eadb] p-5 text-sm leading-7 text-[#4f6268]">
      <strong class="text-[#10242a]">{t.services.commercialNote.split(':')[0]}:</strong>
      {t.services.commercialNote.split(':').slice(1).join(':').trim()}
    </div>
  </div>
</section>
