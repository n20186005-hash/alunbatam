---
import data from '../data/guide.json';import Layout from './Layout.astro';import {paths,type Locale} from '../data/routes';
interface Props {locale:Locale;page:'privacy'|'terms'|'cookies';}
const {locale,page}=Astro.props,d=data.copy[locale],[h,p]=d.legal[page],home=paths.home[locale];
---
<Layout noIndex locale={locale} page={page} title={h+' | Alun-Alun Batam Centre Guide'} description={p.split('. ')[0]+'.'}><main id="main"><section><a href={home}>← {d.back}</a><p class="eyebrow">{d.updated}</p><h1>{h}</h1><p>{p}</p>{page==='privacy'&&<p><a href="https://policies.google.com/privacy">Google Privacy Policy</a> · <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare Privacy Policy</a></p>}{page==='cookies'&&<form id="cookie-settings"><label class="check"><input id="analytics" type="checkbox"/>{d.analytics}</label><button type="submit">{d.save}</button> <button type="button" data-cookie-reject>{d.reject}</button><p data-consent-status role="status" aria-live="polite"></p></form>}</section></main></Layout>
