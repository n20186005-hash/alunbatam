---
import { getContent } from '../content';
import type { Locale } from '../i18n';

interface Props {
  lang?: Locale;
}
const { lang = 'id' } = Astro.props;
const t = getContent(lang);
---

<section id="tanggung-jawab" class="section-pad bg-[#f1eadb]">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="eyebrow">{t.responsibility.eyebrow}</p>
      <h2 class="section-title mt-5">{t.responsibility.h2}</h2>
      <p class="prose-copy mt-6">{t.responsibility.lede}</p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        t.responsibility.topics.map((topic) => (
          <article class="rounded-[1.8rem] border border-black/8 bg-white/62 p-7">
            <span class="text-2xl text-[#0f5f62]" aria-hidden="true">{topic.icon}</span>
            <h3 class="mt-5 text-xl font-extrabold">{topic.title}</h3>
            <p class="mt-3 text-sm leading-7 text-[#43565c]">{topic.body}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-8 rounded-[1.8rem] border border-black/8 bg-white/70 p-7 text-sm leading-7 text-[#43565c]">
      <strong class="text-[#10242a]">{t.responsibility.summary.split(':')[0]}:</strong>
      {t.responsibility.summary.split(':').slice(1).join(':').trim()}
    </div>
  </div>
</section>
