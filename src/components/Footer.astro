---
import { getContent } from '../content';
import type { Locale } from '../i18n';
import Logo from './Logo.astro';

interface Props {
  lang?: Locale;
}
const { lang = 'id' } = Astro.props;
const t = getContent(lang);
---

<footer class="mt-16 bg-[#0a3035] text-[#f7f3e8]">
  <div class="container-shell py-14">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.5fr]">
      <div>
        <Logo light lang={lang} />
        <p class="mt-5 max-w-md text-sm leading-7 text-white/68">{t.footer.tagline}</p>
      </div>
      <div class="grid gap-7 sm:grid-cols-3">
        <div>
          <p class="rule-label !text-[#d4a84f]">{t.footer.guideTitle}</p>
          <nav class="mt-4 flex flex-col gap-2 text-sm text-white/78">
            {t.footer.guideLinks.map((item) => <a class="hover:text-white" href={item.href}>{item.label}</a>)}
          </nav>
        </div>
        <div>
          <p class="rule-label !text-[#d4a84f]">{t.footer.legalTitle}</p>
          <nav class="mt-4 flex flex-col gap-2 text-sm text-white/78">
            {t.footer.legalLinks.map((item) => <a class="hover:text-white" href={item.href}>{item.label}</a>)}
          </nav>
        </div>
        <div>
          <p class="rule-label !text-[#d4a84f]">{t.footer.statusTitle}</p>
          <p class="mt-4 text-sm leading-7 text-white/72">{t.footer.status}</p>
        </div>
      </div>
    </div>
    <div class="my-9 gold-line opacity-35"></div>
    <div class="space-y-3 text-xs leading-6 text-white/58">
      {t.footer.credits.map((line) => <p>{line}</p>)}
      <p>{t.footer.copyright}</p>
    </div>
  </div>
</footer>
