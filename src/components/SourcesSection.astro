---
import { getContent } from '../content';
import { CITY_GOV_URL, GOVT_TOURISM_LABEL, GOVT_TOURISM_URL, MAPS_SHARE_URL } from '../data/site';
import type { Locale } from '../i18n';

interface Props {
  lang?: Locale;
}
const { lang = 'id' } = Astro.props;
const t = getContent(lang);
const mapLabel = lang === 'en' ? 'Google Maps' : 'Google Maps';
const refsText = t.sources.refsText
  .replace('{gov}', `<a href="${GOVT_TOURISM_URL}">${GOVT_TOURISM_LABEL}</a>`)
  .replace('{city}', `<a href="${CITY_GOV_URL}">${lang === 'en' ? 'Batam City Government' : 'Pemerintah Kota Batam'}</a>`);
---

<section id="sumber" class="section-pad">
  <div class="container-shell grid gap-10 lg:grid-cols-[.75fr_1.25fr]">
    <div>
      <p class="eyebrow">{t.sources.eyebrow}</p>
      <h2 class="section-title mt-5">{t.sources.h2}</h2>
      <p class="prose-copy mt-6">{t.sources.lede}</p>
      <div class="mt-7 rounded-2xl border border-black/8 bg-[#efe7d7] p-5 text-sm leading-7 text-[#4f6268]">
        <strong class="text-[#10242a]">{t.sources.principle.split(':')[0]}:</strong>
        {t.sources.principle.split(':').slice(1).join(':').trim()}
      </div>
    </div>
    <div class="card p-7 md:p-9">
      <p class="text-base leading-8 text-[#43565c]">{t.sources.intro}</p>
      <ul class="mt-6 space-y-3 text-sm leading-6 text-[#43565c]">
        {
          t.sources.items.map((item) => (
            <li>
              <a class="font-bold text-[#0f5f62] underline decoration-[#d4a84f] underline-offset-4" href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>{' '}
              <span class="text-[#78868a]">· {item.note}</span>
            </li>
          ))
        }
        <li>
          <a class="font-bold text-[#0f5f62] underline decoration-[#d4a84f] underline-offset-4" href={MAPS_SHARE_URL} target="_blank" rel="noopener noreferrer">{mapLabel}</a>{' '}
          <span class="text-[#78868a]">· {lang === 'en' ? 'location point, coordinates and visitor review snapshot' : 'titik lokasi, koordinat, dan cuplikan ulasan pengunjung'}</span>
        </li>
      </ul>

      <div class="mt-7 rounded-2xl bg-[#f1eadb] p-5 text-sm leading-7 text-[#4f6268]">{t.sources.ratingNote}</div>

      <div class="mt-7 border-t border-black/8 pt-6">
        <p class="rule-label">{t.sources.refsTitle}</p>
        <p class="mt-3 text-sm leading-7 text-[#43565c]" set:html={refsText} />
      </div>
    </div>
  </div>
</section>
