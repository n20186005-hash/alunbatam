---
import { getContent } from '../content';
import type { Locale } from '../i18n';

interface Props {
  lang?: Locale;
}
const { lang = 'id' } = Astro.props;
const t = getContent(lang);
---

<section id="acara" class="section-pad bg-[#082f34] text-white">
  <div class="container-shell">
    <div class="max-w-3xl">
      <p class="eyebrow !text-[#e9c976]">{t.events.eyebrow}</p>
      <h2 class="section-title mt-5">{t.events.h2}</h2>
      <p class="mt-6 text-base leading-8 text-white/70">{t.events.lede}</p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-[1.05fr_.95fr]">
      <div class="space-y-4">
        {
          t.events.checks.map((item) => (
            <article class="rounded-[1.8rem] border border-white/12 bg-white/6 p-7">
              <h3 class="text-xl font-extrabold">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-white/70">{item.body}</p>
            </article>
          ))
        }
      </div>
      <div class="rounded-[1.8rem] border border-white/12 bg-white/6 p-7">
        <p class="rule-label !text-[#e9c976]">{t.events.kindsTitle}</p>
        <ul class="mt-4 space-y-2 text-sm leading-7 text-white/74">
          {t.events.kinds.map((kind) => <li>· {kind}</li>)}
        </ul>
        <div class="mt-6 border-t border-white/12 pt-6">
          <p class="rule-label !text-[#e9c976]">{t.events.channelsTitle}</p>
          <ul class="mt-4 space-y-3 text-sm leading-7">
            {
              t.events.channels.map((channel) => (
                <li>
                  <a class="font-bold text-white underline decoration-[#d4a84f] underline-offset-4" href={channel.href} target="_blank" rel="noopener noreferrer">{channel.label}</a>
                  <span class="text-white/62"> · {channel.note}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-6 text-xs leading-6 text-white/55">{t.events.footnote}</p>
  </div>
</section>
